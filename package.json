{
  "name": "buffy",
  "version": "3.0.0",
  "private": true,
  "description": "A tiny always-on-top companion that reacts to what your coding agent is doing.",
  "author": "slayyyyer",
  "repository": {
    "type": "git",
    "url": "https://github.com/slayyyyer/buffy.git"
  },
  "type": "module",
  "main": "overlay/main.cjs",
  "bin": {
    "buffy": "bin/buffy.js"
  },
  "scripts": {
    "buffy": "node bin/buffy.js",
    "daemon": "node src/daemon.js",
    "start": "electron .",
    "overlay": "electron .",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg zip --x64 --arm64 --publish never",
    "dist:linux": "electron-builder --linux AppImage --x64 --publish never",
    "test": "node --test",
    "smoke:packaged": "node scripts/smoke-packaged.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron/notarize": "^3.1.2",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
